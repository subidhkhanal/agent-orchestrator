# Copy to .env and fill in. Never commit .env.

# --- Database (dedicated to this project) ---------------------------------------------------
# Windows without Docker: `scripts/local_pg.ps1 init` fills these in (private cluster, port 5434).
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5433/agent_orchestrator
TEST_DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5433/agent_orchestrator_test
# Windows only: folder containing libpq.dll (psycopg's pure-Python fallback needs it).
LIBPQ_DIR=C:\Program Files\PostgreSQL\16\bin

# --- Models and tools -----------------------------------------------------------------------
MODELS_CONFIG=config/models.toml
GROQ_API_KEY=
# Optional: without it, web search reports "not configured" (real runs never get fake results).
TAVILY_API_KEY=
DOCQA_BASE_URL=https://d3kmysbupw.us-east-2.awsapprunner.com
# Offline mode: deterministic fake LLM + canned search (CI, chaos tests, local demos).
FAKE_LLM=false

# --- Engine / worker ------------------------------------------------------------------------
CHECKPOINT_EVENT_EVERY_N=5
DEFAULT_MAX_STEPS=30
HITL_TIMEOUT_HOURS=24
WORKER_LEASE_S=30
WORKER_HEARTBEAT_S=5
# WORKER_METRICS_PORT=9100

# --- API and demo mode ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=false
DEMO_MAX_USD_PER_RUN=0.03
DEMO_MAX_TOKENS_PER_RUN=100000
DAILY_USD_CAP=1.00
DAILY_TOKEN_CAP=400000
RATE_LIMIT_RUNS_PER_HOUR=10
MAX_TASK_CHARS=500
# Needed only if workers publish through the HTTP sink endpoint instead of the table.
# PUBLISH_SINK_URL=http://localhost:8000
# PUBLISH_SINK_TOKEN=
